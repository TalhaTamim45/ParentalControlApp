# Storage Mode Selection (json | postgres)
STORAGE_MODE=json

# Parent Credentials & Session
PARENT_USERNAME=parent
PARENT_PASSWORD=change_this_to_strong_parent_password
PARENT_SESSION_SECRET=change_this_to_random_secret_string

# PostgreSQL Database Configuration
PGHOST=db
PGPORT=5432
PGUSER=parental_user
PGPASSWORD=change_this_to_strong_db_password
PGDATABASE=parental_control
DATABASE_URL=postgresql://parental_user:change_this_to_strong_db_password@db:5432/parental_control

# Production Domain Configuration
DOMAIN_NAME=parental.yourdomain.com
