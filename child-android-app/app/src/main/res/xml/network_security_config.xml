<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit HTTP cleartext traffic for local development server host and emulator -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <!-- Permit local IPv4 range for LAN physical phone testing -->
        <domain includeSubdomains="true">192.168.1.100</domain>
    </domain-config>
    <!-- Default for production builds remains strict HTTPS/WSS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
